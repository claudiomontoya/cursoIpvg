# Copia este archivo a .env (sin el .example) y pon tus API keys reales.

# OpenAI (chat + embeddings)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-tu-key-aqui

# Claude (para los ejemplos de RAG end-to-end)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-tu-key-aqui

# Qdrant Cloud — base vectorial usada en ejemplos/python/rag/
# https://cloud.qdrant.io/  →  cluster  →  API keys
QDRANT_URL=https://TU-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=tu-api-key-aqui
